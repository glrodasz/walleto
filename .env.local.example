# Firebase
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_STORAGE_BUCKET=
NEXT_PUBLIC_MESSAGING_SENDER_ID=
NEXT_PUBLIC_APP_ID=

# Firebase Admin (base64 of the service account JSON)
# macOS: base64 -i firebase/serviceAccountKey.dev.json | pbcopy
FIREBASE_SERVICE_ACCOUNT_B64=

ADMIN_USER_ID=

# Auth0
AUTH0_SECRET=
AUTH0_BASE_URL=
AUTH0_ISSUER_BASE_URL=https://
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# API Layer: https://marketplace.apilayer.com/exchangerates_data-api
EXCHANGE_RATES_API_KEY=

# Auth0 Management API (optional) — a Machine-to-Machine application with
# `delete:users`, so deleting an account also removes the Auth0 identity.
# Without it the app erases its own data and the identity is removed by hand.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Settings › Account / About / Data & privacy (all optional)
# Auth0 account page where the user can change password and second factor
NEXT_PUBLIC_AUTH0_ACCOUNT_URL=
# Printed on /privacy as the address for privacy requests
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_FEEDBACK_URL=
# Where Firestore lives, as shown on /privacy, e.g. "Belgium (europe-west1)"
NEXT_PUBLIC_DATA_REGION=
